# Hexagon configuration
comment "Linux Kernel Configuration for Hexagon"

config HEXAGON
	def_bool y
	select ARCH_32BIT_OFF_T
	select ARCH_HAS_DELAY_TIMER
	select ARCH_HAS_SYNC_DMA_FOR_DEVICE
	select ARCH_NO_PREEMPT
	select ARCH_WANT_FRAME_POINTERS
	select ARCH_HAS_SYSCALL_WRAPPER
	select ARCH_HAS_UBSAN
	select HAVE_ARCH_KASAN if !HEXAGON_SPLIT_2GB
	select ARCH_SUPPORTS_CFI
	select ARCH_USES_CFI_TRAPS if CFI
	select ARCH_SUPPORTS_SHADOW_CALL_STACK
	select DMA_GLOBAL_POOL
	select HAVE_PAGE_SIZE_4KB
	select HAVE_PAGE_SIZE_16KB
	select HAVE_PAGE_SIZE_64KB
	select HAVE_PAGE_SIZE_256KB
	select FRAME_POINTER
	# Other pending projects/to-do items.
	select HAVE_REGS_AND_STACK_ACCESS_API
	# select HAVE_HW_BREAKPOINT if PERF_EVENTS
	# select ARCH_HAS_CPU_IDLE_WAIT
	# select GPIOLIB
	# select HAVE_CLK
	select GENERIC_ATOMIC64
	select HAVE_EBPF_JIT
	select HAVE_PERF_EVENTS
	# GENERIC_ALLOCATOR is used by dma_alloc_coherent()
	select GENERIC_ALLOCATOR
	select GENERIC_IRQ_PROBE
	select GENERIC_IRQ_SHOW
	select HAVE_ARCH_KGDB
	select HAVE_ARCH_TRACEHOOK
	select HAVE_SYSCALL_TRACEPOINTS
	select NEED_SG_DMA_LENGTH
	select GENERIC_IOREMAP
	select GENERIC_SMP_IDLE_THREAD
	select STACKTRACE_SUPPORT
	select GENERIC_CLOCKEVENTS_BROADCAST
	select LOCK_MM_AND_FIND_VMA
	select MODULES_USE_ELF_RELA
	select GENERIC_CPU_DEVICES
	select ARCH_WANT_LD_ORPHAN_WARN
	select TRACE_IRQFLAGS_SUPPORT
	select IRQ_DOMAIN
	select OF
	select OF_EARLY_FLATTREE
	help
	  Qualcomm Hexagon is a processor architecture designed for high
	  performance and low power across a wide variety of applications.

config KASAN_SHADOW_OFFSET
	hex
	depends on KASAN
	default 0xde400000
	help
	  KASAN maps an address to its shadow byte with
	  (addr >> 3) + KASAN_SHADOW_OFFSET.  The value here places the
	  shadow of the kernel map at KASAN_SHADOW_START; the two are
	  derived from each other in <asm/kasan.h>, so they must be changed
	  together.

config HEXAGON_PHYS_OFFSET
	def_bool y
	help
	  Platforms that don't load the kernel at zero set this.

config LOCKDEP_SUPPORT
	def_bool y

config EARLY_PRINTK
	def_bool y

config MMU
	def_bool y

config NO_IOPORT_MAP
	def_bool y

config GENERIC_CSUM
	def_bool y

config GENERIC_CALIBRATE_DELAY
	def_bool y

config GENERIC_HWEIGHT
	def_bool y

config STACKTRACE_SUPPORT
	def_bool y
	select STACKTRACE

config GENERIC_BUG
	def_bool y
	depends on BUG

menu "Machine selection"

choice
	prompt "System type"
	default HEXAGON_COMET

config HEXAGON_QEMU
	bool "QEMU virt machine"
	select HEXAGON_PHYS_OFFSET
	select ARM_AMBA
	select COMMON_CLK
	select HEXAGON_H2
	help
	  Support for the QEMU hexagon "virt" machine.

config HEXAGON_QCS6490_CDSP
	bool "Qualcomm QCS6490 Compute DSP"
	select HEXAGON_PHYS_OFFSET
	select ARM_AMBA
	select COMMON_CLK
	select HEXAGON_H2
	help
	  Support for the Hexagon v68 compute DSP of the Qualcomm QCS6490,
	  running as a guest of the H2 hypervisor.  The console is the
	  PL011 that QEMU's qcs6490-cdsp machine adds for this purpose; the
	  hardware has no UART.

config HEXAGON_SM8975_NSP
	bool "Qualcomm SM8975 NSP"
	select HEXAGON_PHYS_OFFSET
	select ARM_AMBA
	select COMMON_CLK
	select HEXAGON_H2
	help
	  Support for the SM8975 NSP running under the H2 hypervisor.
	  The supplied device tree describes QEMU's sm8975-nsp machine,
	  including its emulated PL011 console.

config HEXAGON_COMET
	bool "Comet Board"
	help
	  Support for the Comet platform.

endchoice

config HEXAGON_ARCH_VERSION
	int "Architecture version"
	default 2

config CMDLINE
	string "Default kernel command string"
	default ""
	help
	  On some platforms, there is currently no way for the boot loader
	  to pass arguments to the kernel. For these, you should supply some
	  command-line options at build time by entering them here.  At a
	  minimum, you should specify the memory size and the root device
	  (e.g., mem=64M root=/dev/nfs).

config HEXAGON_PMU
	bool "Hexagon performance monitoring unit (perf)"
	depends on HEXAGON_H2 && PERF_EVENTS
	default y
	help
	  Support for the core's performance counters in perf, through the
	  hypervisor: a PMU named "hexagon", counting the whole core.

config HEXAGON_H2_INFO
	bool "Hypervisor and core information in sysfs and debugfs"
	depends on HEXAGON_H2
	default y
	help
	  Export what the hypervisor tells a guest about itself and the core it
	  runs on, and the state of the core's performance monitoring unit, in
	  /sys/kernel/hexagon and, with debugfs, /sys/kernel/debug/hexagon.

config HEXAGON_H2
	bool "H2 hypervisor interface"
	help
	  Support for running under the Hexagon H2 hypervisor (as opposed
	  to bare metal or an older/simpler VM interface). This provides
	  the trap-based hypercall interface, the H2 interrupt controller,
	  and the H2 timer that the QEMU "virt" machine and current
	  hardware targets require. Platforms without an H2 hypervisor
	  should leave this disabled.

config SMP
	bool "Multi-Processing support"
	help
	  Enables SMP support in the kernel.  If unsure, say "Y"

config NR_CPUS
	int "Maximum number of CPUs" if SMP
	range 2 16 if SMP
	default "1" if !SMP
	default "6" if SMP
	help
	  This allows you to specify the maximum number of CPUs which this
	  kernel will support.  The maximum supported value is 16 and the
	  minimum value which makes sense is 2.

	  This is purely to save memory - each supported CPU adds
	  approximately eight kilobytes to the kernel image.

config BASE_IPI_IRQ
	int "Base IPI IRQ" if SMP
	range 0 11 if HEXAGON_H2
	default 0
	help
	  The IRQ used for IPI calls. H2 uses the same per-CPU IRQ on
	  every CPU; other hypervisors increment the base for each CPU.

	  The IRQs used by IPIs must not overlap interrupts claimed by
	  devices. For H2, interrupt 12 is reserved for the timer.

	  Todo:  Maybe make this a devtree thing instead?

source "kernel/Kconfig.hz"

source "arch/hexagon/kernel/hvx/Kconfig"

source "arch/hexagon/kernel/hmx/Kconfig"

config HEXAGON_HLX
	bool "Userspace HLX context management"
	depends on HEXAGON_H2
	select HAVE_EXIT_THREAD
	help
	  Allocate HLX contexts on demand and preserve their register state
	  across task switches.

endmenu
