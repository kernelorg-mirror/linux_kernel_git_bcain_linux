# Minimal initramfs for QEMU boot testing
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3
nod /dev/zero 0666 0 0 c 1 5
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /tmp 0755 0 0
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /lib 0755 0 0
file /lib/ld-musl-hexagon.so.1 /local/mnt/workspace/upstream/buildroot/output/target/lib/ld-musl-hexagon.so.1 0755 0 0
file /bin/busybox /local/mnt/workspace/upstream/buildroot/output/target/bin/busybox 0755 0 0
slink /bin/sh busybox 0755 0 0
slink /sbin/init /bin/sh 0755 0 0
file /bin/fastrpc_dispatcher /local/mnt/workspace/kernel/bcain_linux/arch/hexagon/tools/fastrpc_dispatcher 0755 0 0
file /init /local/mnt/workspace/kernel/bcain_linux/arch/hexagon/configs/qemu_init.sh 0755 0 0
