CONFIG_HEXAGON_QCS6490_CDSP=y
CONFIG_HEXAGON_ARCH_VERSION=68
# lpj= is required: calibrate_delay() cannot be trusted this early against
# the H2 virtualized timer under TCG, so a measured loops_per_jiffy is
# baked in rather than calibrated at boot.
CONFIG_CMDLINE="console=ttyAMA0 mem=240M lpj=89124080"
CONFIG_SMP=y
CONFIG_NR_CPUS=6
CONFIG_PAGE_SIZE_64KB=y
CONFIG_HZ_100=y
CONFIG_DEFAULT_HOSTNAME="qcs6490-cdsp"
CONFIG_LOG_BUF_SHIFT=18
CONFIG_BLK_DEV_INITRD=y
CONFIG_KALLSYMS_ALL=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NETDEVICES=y
CONFIG_RPMSG_QCOM_GLINK_SHMEM=y
CONFIG_RPMSG_NET=y
CONFIG_CLK_QCS6490_CDSP=y
CONFIG_UIO=y
CONFIG_UIO_HEXAGON_VTCM=y
CONFIG_HEXAGON_HVX=y
CONFIG_HEXAGON_HMX=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_HWMON is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_IOMMU_SUPPORT is not set
CONFIG_TMPFS=y
# CONFIG_MISC_FILESYSTEMS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_FS=y
CONFIG_PERF_EVENTS=y
